# API access for the agent models. Fill in your own endpoint and key.
# All runners read these three variables; the launch scripts pass an env file
# via `docker run --env-file`.
LLM_MODEL=<model-id, e.g. gpt-4.1-mini>
LLM_API_KEY=<your-api-key>
LLM_BASE_URL=<https://api.example.com/v1>

# Optional pins used by specific runners (see src/compat/):
# GLM_THINKING_OFF=1        # AgentScope x GLM arm only
